# AgriSense AI Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./data/agrisense.db

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/3.0

# Commodity Prices API (Alpha Vantage - free tier)
COMMODITY_API_KEY=your_alphavantage_api_key_here
COMMODITY_API_BASE_URL=https://www.alphavantage.co/query

# App Settings
LOG_LEVEL=INFO
MODEL_PATH=./data/models/
SAMPLE_DATA_PATH=./data/samples/

# Hugging Face (for deployment)
HF_USERNAME=your_hf_username
HF_SPACE_NAME=agrisense-ai
