# AgriSense AI Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./data/agrisense.db

# Gemini API (for AI explanations — optional, falls back to rule-based)
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Free Public APIs (no keys required — works out of the box) ----
# SMHI Open Data — Swedish weather observations
SMHI_BASE_URL=https://opendata-download-metobs.smhi.se/api/version/1.0
# EU Agri-Food Data Portal — cereal/grain prices
EU_AGRIFOOD_BASE_URL=https://api.tech.ec.europa.eu/agrifood
# FAOSTAT (UN FAO) — crop production, yield, and price statistics
FAOSTAT_BASE_URL=https://fenixservices.fao.org/faostat/api/v2/en
# Eurostat — EU agricultural price indices and economic data
EUROSTAT_BASE_URL=https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data

# App Settings
LOG_LEVEL=INFO
MODEL_PATH=./data/models/
SAMPLE_DATA_PATH=./data/samples/

# Hugging Face (for deployment)
HF_USERNAME=your_hf_username
HF_SPACE_NAME=agrisense-ai
